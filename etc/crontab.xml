<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Build + send the throttled digest of new/changed errors. -->
        <job name="panth_errormonitor_dispatch_notifications"
             instance="Panth\ErrorMonitor\Cron\DispatchNotifications" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <!-- Prune old events and resolved groups per retention config. -->
        <job name="panth_errormonitor_cleanup"
             instance="Panth\ErrorMonitor\Cron\Cleanup" method="execute">
            <schedule>27 3 * * *</schedule>
        </job>
        <!-- Daily heartbeat — no-op when Panth_Core handles it. -->
        <job name="panth_errormonitor_send_heartbeat"
             instance="Panth\ErrorMonitor\Cron\SendHeartbeat" method="execute">
            <schedule>43 4 * * *</schedule>
        </job>
    </group>
</config>
