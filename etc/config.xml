<?xml version="1.0"?>
<!--
/**
 * Copyright © Panth Infotech. All rights reserved.
 *
 * Safe defaults: capture is ON, email alerts are OFF until an admin enters
 * recipients (so no surprise mail). Aggressive throttling out of the box.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <panth_errormonitor>
            <general>
                <enabled>1</enabled>
                <auto_pause_window_minutes>5</auto_pause_window_minutes>
                <filter_ecosystem_alerts>1</filter_ecosystem_alerts>
                <max_events_per_group>50</max_events_per_group>
                <event_cap_mode>oldest</event_cap_mode>
                <ignore_patterns>Script error for
ChunkLoadError
Loading chunk
ResizeObserver loop limit exceeded
ResizeObserver loop completed with undelivered notifications.
Non-Error promise rejection captured</ignore_patterns>
            </general>
            <filters>
                <ignore_bots>1</ignore_bots>
                <bot_user_agents>bot
crawl
spider
slurp
bingbot
baiduspider
sogou
dotbot
ahrefs
semrush
yandex
petal
headless
probe
preview
facebookexternalhit
facebookcatalog
Google-Read-Aloud</bot_user_agents>
                <email_exclude_bot_only>1</email_exclude_bot_only>
                <noise_enabled>1</noise_enabled>
                <noise_patterns><![CDATA[Object Not Found Matching Id:\d+, MethodName:\w+, ParamCount:\d+
source:customer-data|js\.storage|jquery[.-]storageapi && message:storage\.remove|delete tmp\[a\[i\]\]|QuotaExceededError|\(reading 'remove'\)|'remove' of (?:undefined|null)|evaluating '[\w$.]*remove'|SecurityError|operation is insecure|localStorage|sessionStorage
nostack:^(?:Uncaught\s+)?Script error\.?$
any:(?:chrome|moz|safari|safari-web|ms-browser)-extension://]]></noise_patterns>
            </filters>
            <php_capture>
                <enabled>1</enabled>
                <min_severity>error</min_severity>
                <throttle_window_seconds>60</throttle_window_seconds>
                <graphql_client_errors>skip</graphql_client_errors>
            </php_capture>
            <js_capture>
                <enabled>1</enabled>
                <sample_rate>100</sample_rate>
                <rate_limit_per_minute>30</rate_limit_per_minute>
                <max_body_kb>16</max_body_kb>
                <max_new_groups_per_hour>100</max_new_groups_per_hour>
            </js_capture>
            <email>
                <enabled>0</enabled>
                <mode>daily_summary</mode>
                <send_hour>23</send_hour>
                <recipients></recipients>
                <sender>general</sender>
                <min_severity>error</min_severity>
                <max_per_run>50</max_per_run>
            </email>
            <privacy>
                <store_ip>1</store_ip>
                <anonymize_ip>1</anonymize_ip>
            </privacy>
            <retention>
                <event_days>30</event_days>
                <resolved_group_days>90</resolved_group_days>
                <unresolved_group_days>0</unresolved_group_days>
            </retention>
        </panth_errormonitor>
    </default>
</config>
