<?php
/**
 * Copyright © Panth Infotech. All rights reserved.
 *
 * Error cards for the alert email. Rendered via the {{block}} directive so the
 * markup is emitted as trusted HTML; every dynamic field is escaped here.
 *
 * @var \Panth\ErrorMonitor\Block\Email\Summary $block
 * @var \Magento\Framework\Escaper $escaper
 */
$rows = $block->getRows();
$muted = 'margin:0 0 6px;font-size:12px;color:#64748b;';
?>
<?php if (empty($rows)): ?>
    <p style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#334155;">
        <?= $escaper->escapeHtml(__('No errors to report.')) ?>
    </p>
<?php else: ?>
    <?php foreach ($rows as $row): ?>
        <?php
        $severity = strtolower((string)$row['severity']);
        $color = $block->severityColor($severity);
        $line = (int)($row['line'] ?? 0);
        $fileLine = trim((string)$row['file'] . ($line ? ':' . $line : ''));
        ?>
        <table cellpadding="0" cellspacing="0" border="0" width="100%"
               style="margin:0 0 16px;border:1px solid #e2e8f0;border-radius:8px;border-collapse:separate;">
            <tr>
                <td style="padding:14px 18px;font-family:Arial,Helvetica,sans-serif;">
                    <span style="display:inline-block;padding:2px 8px;border-radius:4px;background:<?= $escaper->escapeHtmlAttr($color) ?>;color:#ffffff;font-size:11px;text-transform:uppercase;letter-spacing:.5px;">
                        <?= $escaper->escapeHtml(strtoupper($severity)) ?>
                    </span>
                    <span style="color:#64748b;font-size:12px;margin-left:6px;">
                        <?= $escaper->escapeHtml(strtoupper((string)$row['source'])) ?>
                    </span>
                    <span style="color:#64748b;font-size:12px;margin-left:6px;">
                        #<?= (int)$row['group_id'] ?>
                    </span>
                    <p style="margin:10px 0 4px;font-size:15px;color:#0f172a;font-weight:bold;">
                        <?= $escaper->escapeHtml((string)$row['error_type']) ?>
                    </p>
                    <p style="margin:0 0 8px;font-size:14px;color:#334155;line-height:1.5;">
                        <?= $escaper->escapeHtml($block->shorten((string)$row['message'], 300)) ?>
                    </p>
                    <?php if ($fileLine !== ''): ?>
                        <p style="<?= $escaper->escapeHtmlAttr($muted) ?>font-family:'Courier New',monospace;word-break:break-all;">
                            <?= $escaper->escapeHtml($fileLine) ?>
                            <?php if (!empty($row['line_unreliable'])): ?>
                                <span style="font-family:Arial,Helvetica,sans-serif;color:#94a3b8;">
                                    (<?= $escaper->escapeHtml(__('line number may be unreliable for minified or preprocessed files')) ?>)
                                </span>
                            <?php endif; ?>
                        </p>
                    <?php endif; ?>
                    <?php if ((string)$row['top_url'] !== ''): ?>
                        <p style="<?= $escaper->escapeHtmlAttr($muted) ?>word-break:break-all;">
                            <?= $escaper->escapeHtml(__('Top URL')) ?>:
                            <?= $escaper->escapeHtml($block->shorten((string)$row['top_url'], 200)) ?>
                        </p>
                    <?php endif; ?>
                    <p style="<?= $escaper->escapeHtmlAttr($muted) ?>">
                        <strong><?= $escaper->escapeHtml($block->formatCounts($row)) ?></strong>
                        &nbsp;|&nbsp;
                        <?= $escaper->escapeHtml(__('Bots')) ?>: <?= (int)$row['bot_pct'] ?>%
                    </p>
                    <p style="margin:0 0 12px;font-size:12px;color:#64748b;">
                        <?= $escaper->escapeHtml(__('First seen')) ?>:
                        <?= $escaper->escapeHtml((string)$row['first_seen']) ?>
                        &nbsp;|&nbsp;
                        <?= $escaper->escapeHtml(__('Last seen')) ?>:
                        <?= $escaper->escapeHtml((string)$row['last_seen']) ?>
                    </p>
                    <a href="<?= $escaper->escapeUrl($block->getViewUrl($row)) ?>"
                       style="display:inline-block;padding:8px 16px;background:#0f172a;color:#ffffff;text-decoration:none;border-radius:6px;font-size:13px;font-family:Arial,Helvetica,sans-serif;">
                        <?= $escaper->escapeHtml(__('View details')) ?>
                    </a>
                </td>
            </tr>
        </table>
    <?php endforeach; ?>
<?php endif; ?>
<?php foreach ($block->getFooterLines() as $footerLine): ?>
    <p style="margin:8px 0 0;font-size:12px;color:#64748b;font-family:Arial,Helvetica,sans-serif;line-height:1.6;">
        <?= $escaper->escapeHtml($footerLine) ?>
    </p>
<?php endforeach; ?>
